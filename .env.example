# Copia estos nombres a las variables SEGURAS de tu servicio de alojamiento.
# No pegues una clave real en este archivo ni en el APK.
WINY_AI_KEY=
WINY_AI_PROVIDER=openai
WINY_AI_MODEL=gpt-5.4-mini
# Para usar Gemini, selecciona WINY_AI_PROVIDER=gemini y configura su clave.
WINY_GEMINI_KEY=
WINY_GEMINI_MODEL=gemini-3.8-flash
# También se admiten los nombres estándar GEMINI_API_KEY y GEMINI_MODEL.
WINY_AI_DAILY_LIMIT=20
# Ruta de un disco persistente en producción; debe ser privada.
WINY_DB=.local/winy.sqlite
WINY_HOST=0.0.0.0
PORT=4173

# Cuentas y progreso persistente (docs/cuentas.md). Clave publicable, no service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Respaldo opcional e independiente. Se activa al definir WINY_AI_FALLBACK=groq.
WINY_AI_FALLBACK=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
